<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>
	<!-- データベースドライバ: ローカルハードディスク上のデータベースドライバパッケージを選択してください -->
	<classPathEntry location="C:\Users\ryu00\.m2\repository\org\postgresql\postgresql\42.7.3\postgresql-42.7.3.jar" />
	<context id="MySQLContext" targetRuntime="MyBatis3"
		defaultModelType="flat">
		<commentGenerator>
			<property name="suppressDate" value="true" />
			<!-- 自動生成されるコメントを除去するかどうか true: はい、 false: いいえ -->
			<property name="suppressAllComments" value="false" />
		</commentGenerator>
		<!-- データベース接続URL、ユーザー名、パスワード -->
		<jdbcConnection driverClass="org.postgresql.Driver"
                        connectionURL="jdbc:postgresql://localhost:5432/postgres?nullCatalogMeansCurrent=true"
                        userId="postgres"
                        password="postgres">
        </jdbcConnection>
		<javaTypeResolver>
			<property name="forceBigDecimals" value="false" />
		</javaTypeResolver>
		<!-- モデルのパッケージ名と位置 -->
		<javaModelGenerator
			targetPackage="com.kyh.system.model" targetProject="src/main/java">
			<property name="enableSubPackages" value="true" />
			<property name="trimStrings" value="true" />
		</javaModelGenerator>
		<!-- マッピングファイルのパッケージ名と位置 -->
		<sqlMapGenerator targetPackage="mapper"
			targetProject="src/main/resources">
			<property name="enableSubPackages" value="true" />
		</sqlMapGenerator>
		<!-- DAOのパッケージ名と位置 -->
		<javaClientGenerator type="XMLMAPPER"
			targetPackage="com.kyh.system.mapper" targetProject="src/main/java">
			<property name="enableSubPackages" value="true" />
		</javaClientGenerator>
		<!-- 生成するテーブル tableNameはデータベース内のテーブル名またはビュー名、domainObjectNameはエンティティクラス名 -->
		<table tableName="syain_main" domainObjectName="Syain">
			<generatedKey column="syain_id" sqlStatement="PostgreSQL"
				identity="true" />
		</table>
	</context>
</generatorConfiguration>
